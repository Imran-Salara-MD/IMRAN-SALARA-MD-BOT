# ============================================
# ❝𝐈𝐌𝐑𝐀𝐍-𝐒𝐀𝐋𝐀𝐑𝐀-𝐌𝐃-𝐁𝐎𝐓❞ - Environment Configuration
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file - it contains secrets.
# ============================================

# --- Bot Branding (safe to leave as-is, or customize) ---
BOT_NAME=❝𝐈𝐌𝐑𝐀𝐍-𝐒𝐀𝐋𝐀𝐑𝐀-𝐌𝐃-𝐁𝐎𝐓❞
OWNER_NAME=❝𝐈𝐌𝐑𝐀𝐍-𝐒𝐀𝐋𝐀𝐑𝐀-𝐌𝐃-𝐁𝐎𝐓❞
OWNER_NUMBER=923200799496
OWNER_DISPLAY_NUMBER=03200799496
WELCOME_MESSAGE=welcome ❝𝐈𝐌𝐑𝐀𝐍-𝐒𝐀𝐋𝐀𝐑𝐀-𝐌𝐃-𝐁𝐎𝐓❞
# A custom banner.jpg is bundled in the project root and is auto-served by
# the bot's own web server at <your-app-url>/banner.jpg (e.g.
# https://your-app-name.herokuapp.com/banner.jpg). Set LOGO_URL to that
# address to use it instead of the default logo below.
LOGO_URL=https://i.ibb.co/GyZMhVd/botdp.jpg
CHANNEL_URL=https://whatsapp.com/channel/0029Vb9FqCoAjPXGL9rVIb1T

# --- Telegram (optional) ---
# Only needed if you want pairing codes delivered via a Telegram bot.
# Get a token from @BotFather on Telegram. Leave blank to disable this feature.
TELEGRAM_BOT_TOKEN=YOUR_TOKEN_HERE

# --- AI / .ai command (optional) ---
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo

# --- Giphy (optional, has a public fallback key already) ---
GIPHY_API_KEY=

# --- Tenor (required only for .emojimix) ---
# Get a free key at https://developers.google.com/tenor
TENOR_API_KEY=

# --- YouTube Data API (optional, only needed for .islamic video auto-posting) ---
# Get a free key at https://developers.google.com/youtube/registering_an_application
YOUTUBE_API_KEY=

# --- Islamic Auto-Posting (optional defaults) ---
DEFAULT_CITY=Lahore
DEFAULT_COUNTRY=Pakistan
DEFAULT_TIMEZONE=Asia/Karachi

# --- Session Persistence (STRONGLY recommended on Heroku) ---
# Heroku's filesystem is wiped on every dyno restart (at least once every ~24h),
# which normally forces you to re-scan/re-pair WhatsApp constantly.
# Set this to a free MongoDB Atlas connection string to persist the session
# in the database instead, so the bot stays connected 24/7.
# Get a free cluster at https://www.mongodb.com/atlas -> Connect -> Drivers -> copy the URI.
# Leave blank to use local file storage (fine for local machines / Termux only).
MONGODB_URI=

# --- Server ---
PORT=3000
# Public URL of this instance, used only for the built-in anti-sleep ping.
# Leave as default for local/Termux use.
APP_URL=http://localhost:3000
